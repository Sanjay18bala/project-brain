NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
NEMOTRON_MODEL=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B

# Shared secret required as the X-API-Key header on first-party API requests
# (GET /projects/{id}/graph). Not used on /events/github or /events/slack —
# those are authenticated by their own webhook signatures instead.
API_KEY=

# Single demo project webhook events are written into (see database/seed/demo_project.sql).
DEFAULT_PROJECT_ID=00000000-0000-0000-0000-000000000001

# Recency-decay time constant for conflict scoring, in seconds (default 24h). Tune against
# real usage — a fast-moving team may want minutes, not hours.
RECENCY_HALF_LIFE_SECONDS=86400

# Frontend (Vite) config — must be prefixed VITE_ to reach the browser bundle.
VITE_API_BASE=http://localhost:8000
VITE_API_KEY=
VITE_DEMO_PROJECT_ID=00000000-0000-0000-0000-000000000001

# Origins allowed to call the API from a browser (comma-separated).
CORS_ORIGINS=http://localhost:5173

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_WEBHOOK_SECRET=
# The App's slug from its settings URL (github.com/settings/apps/<slug>) - used to build
# the install URL for the "Connect GitHub" flow (docs/roadmap-v3-onboarding.md).
GITHUB_APP_SLUG=

SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=

# Google Chat HTTP endpoint app. Set to the exact public URL Google Chat is configured to
# call (e.g. https://your-domain.com/events/googlechat) - used as the expected audience
# when verifying Google's signed bearer token. Not a shared secret.
GOOGLE_CHAT_AUDIENCE=

DATABASE_URL=postgresql://project_brain:project_brain@localhost:5432/project_brain
